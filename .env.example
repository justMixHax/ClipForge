# ClipForge settings. Copy to .env and change what you need. Every value here is optional.
# Do not put API keys in this file: add them in the app under Settings, where they are stored encrypted.

# Address the app listens on. Leave on 127.0.0.1 so only this PC can reach it.
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=3000

# Listening on anything other than this PC is refused unless this is set to true. There is no login,
# so only do that on a network you fully trust.
CLIPFORGE_ALLOW_REMOTE=false

# Where videos, clips, models, the database and logs are kept. Default: the "data" folder in the project.
# CLIPFORGE_DATA_DIR=D:\ClipForgeData

# Largest file the browser may upload, in GB. Bigger recordings can be linked from disk instead.
CLIPFORGE_MAX_UPLOAD_GB=20

# Full paths, only needed if ffmpeg and ffprobe are not on PATH.
# CLIPFORGE_FFMPEG_PATH=C:\Tools\ffmpeg\bin\ffmpeg.exe
# CLIPFORGE_FFPROBE_PATH=C:\Tools\ffmpeg\bin\ffprobe.exe

# DEBUG, INFO, WARNING or ERROR
CLIPFORGE_LOG_LEVEL=INFO

# The web server starts and watches the processing worker. Set to false to run the worker yourself:
#   <venv>\Scripts\python.exe -m app.jobs.worker      (from the backend folder)
CLIPFORGE_SPAWN_WORKER=true
